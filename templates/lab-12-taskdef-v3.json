{
  "containerDefinitions": [
    {
      "name": "enrolment-api",
      "image": "000000000000.dkr.ecr.us-east-1.localhost:4566/usms-enrolment:r6",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "USMS_SERVICE",
          "value": "enrolment"
        },
        {
          "name": "USMS_BUCKET",
          "value": "usms-student-data"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "USMS_LOG_LEVEL",
          "value": "info"
        }
      ]
    }
  ],
  "family": "usms-enrolment",
  "taskRoleArn": "arn:aws:iam::000000000000:role/usms-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::000000000000:role/usms-ecs-exec-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "1024"
}