# ============================================================
#  aws-floci-course/.gitignore
#  Written BEFORE any secret existed. Keep it that way.
# ============================================================

# ---- Command output and SECRETS ----
# NOTE the trailing /* — see the explanation below. It matters.
outputs/*
!outputs/.gitkeep

# ---- Generated Compose configuration ----
# floci-up.sh writes this. It holds machine-specific absolute paths.
.env
.env.local

# ---- Emulator state ----
floci-data/
data/
.floci/

# ---- Credentials of every shape ----
*.pem
*.key
*-access-key.json
*credentials*
# ...but this one is a POLICY DOCUMENT, not a credential. The rule above matches
# it on the word "credentials" alone. Same negation trick as outputs/.gitkeep:
# it works because policies/ itself is not excluded.
!policies/usms-self-manage-credentials.json

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
