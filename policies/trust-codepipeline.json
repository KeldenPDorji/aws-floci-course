{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CodePipelineAssumesThisRole",
      "Effect": "Allow",
      "Principal": { "Service": "codepipeline.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "000000000000" }
      }
    }
  ]
}
