{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CodeBuildAssumesThisRoleForTheseProjectsOnly",
      "Effect": "Allow",
      "Principal": { "Service": "codebuild.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "000000000000" },
        "ArnLike": {
          "aws:SourceArn": [
            "arn:aws:codebuild:us-east-1:000000000000:project/usms-enrolment-build",
            "arn:aws:codebuild:us-east-1:000000000000:project/usms-results-build",
            "arn:aws:codebuild:us-east-1:000000000000:project/usms-enrolment-build-standalone"
          ]
        }
      }
    }
  ]
}
