version: 0.2

env:
  variables:
    SERVICE_NAME: "enrolment"
    ARTIFACT_DIR: "dist"

phases:

  install:
    commands:
      - echo "--- install ---"
      - python3 --version
      - sed --version 2>/dev/null | head -1 || echo "BSD sed"

  pre_build:
    commands:
      - echo "--- pre_build ---"
      - test -f VERSION || { echo "VERSION file is missing"; exit 1; }
      - python3 -m json.tool config/service.json > /dev/null
      # Exercise 3: parse, do not grep. Indifferent to whitespace and key order; names the
      # expected AND the actual value. Covers the container check (Step 8) and the port
      # check (Step 8 "Your turn"). Standard library only.
      - |
        python3 - << 'PY'
        import json, sys
        cfg = json.load(open("config/service.json"))
        want = {
            "container": ("enrolment-api", "the ECS task definition's container name (Lab 04)"),
            "port": (80, "the ALB target group and the task definition both expect 80"),
        }
        bad = ["config/service.json: %s must be %r - %s - but it is %r"
               % (k, v, why, cfg.get(k, "<missing>"))
               for k, (v, why) in want.items() if cfg.get(k) != v]
        print("\n".join(bad) if bad else "container=%s port=%s" % (cfg["container"], cfg["port"]))
        sys.exit(1 if bad else 0)
        PY
      - echo "configuration validated"

  build:
    commands:
      - echo "--- build ---"
      - USMS_RELEASE="$(tr -d '[:space:]' < VERSION)"
      - BUILT_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      - echo "release=$USMS_RELEASE builtAt=$BUILT_AT"
      - rm -rf "$ARTIFACT_DIR"
      - mkdir -p "$ARTIFACT_DIR"
      - cp -R src/. "$ARTIFACT_DIR"/
      - sed -i.bak -e "s|__RELEASE__|$USMS_RELEASE|g" -e "s|__BUILT_AT__|$BUILT_AT|g" "$ARTIFACT_DIR/index.html"
      - rm -f "$ARTIFACT_DIR/index.html.bak"
      - |
        cat > "$ARTIFACT_DIR/build-metadata.json" << META
        {
          "service": "$SERVICE_NAME",
          "release": "$USMS_RELEASE",
          "builtAt": "$BUILT_AT",
          "buildId": "${CODEBUILD_BUILD_ID:-local}",
          "sourceVersion": "${CODEBUILD_RESOLVED_SOURCE_VERSION:-local}"
        }
        META
      - cp config/service.json "$ARTIFACT_DIR/service.json"
      # Exercise 5: the deployment contract Lab 12's ECS deploy action reads. A JSON ARRAY
      # (Lab 12 fails on an object), container name taken from config/service.json - not typed
      # a second time - and the image from IMAGE_URI, defaulting to what the service runs today
      # (task definition usms-enrolment:2). Lab 12 sets IMAGE_URI to the image it pushes.
      - |
        export IMAGE_URI="${IMAGE_URI:-public.ecr.aws/nginx/nginx:stable-alpine}"
        python3 -c 'import json,os,sys; c=json.load(open("config/service.json"))["container"]; json.dump([{"name": c, "imageUri": os.environ["IMAGE_URI"]}], open(sys.argv[1], "w"))' "$ARTIFACT_DIR/imagedefinitions.json"
        cat "$ARTIFACT_DIR/imagedefinitions.json"; echo

  post_build:
    commands:
      - echo "--- post_build ---"
      # Record the tests' exit status for finally, then fail the phase if they failed.
      # "&& ... || ..." rather than a bare call so it also works under the local runner's set -e.
      - |
        bash tests/smoke.sh && SMOKE_STATUS=0 || SMOKE_STATUS=$?
        echo "$SMOKE_STATUS" > "${TMPDIR:-/tmp}/usms-smoke-status"
        test "$SMOKE_STATUS" -eq 0
      - ls -l "$ARTIFACT_DIR"
      - cat "$ARTIFACT_DIR/build-metadata.json"
    # Exercise 2: runs whether the commands above succeeded or failed. It does not rescue
    # the phase - a failed post_build still fails the build - it only guarantees the summary.
    finally:
      - |
        mkdir -p "$ARTIFACT_DIR"
        printf 'release=%s tests_exit=%s at=%s\n' "$(tr -d '[:space:]' < VERSION)" "$(cat "${TMPDIR:-/tmp}/usms-smoke-status" 2>/dev/null || echo not-run)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$ARTIFACT_DIR/build-summary.txt"
        cat "$ARTIFACT_DIR/build-summary.txt"

artifacts:
  base-directory: dist
  files:
    - '**/*'

cache:
  paths: []
